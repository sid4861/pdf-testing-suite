{
  "name": "@pdfsuite/create",
  "version": "2.0.0",
  "description": "npm create @pdfsuite \u2014 a new app, or pdfsuite added to one you have, and kept in step on upgrade.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-pdfsuite": "./bin/create-pdfsuite.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && node build.mjs",
    "prepack": "tsc -p tsconfig.build.json && node build.mjs"
  }
}
