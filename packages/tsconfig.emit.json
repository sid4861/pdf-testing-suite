{
  // The shared emit settings — W-52.
  //
  // Every package extends this to write `dist/*.js` and `dist/*.d.ts`. It is
  // `tsc` and not esbuild because **declarations are the point**: a consumer
  // running `tsc` must type-check against our `.d.ts`, never against our
  // source. Before this they got eleven errors of ours in their project.
  //
  // `?url` and `.css` imports pass through untouched. They are not ours to
  // resolve — the consumer's bundler does it, and that is the only place
  // they are resolvable.
  //
  // `outDir` and `rootDir` are **not** here: a relative path in an extended
  // config resolves against the file it is written in, so both would point
  // at `packages/` rather than at the package. Each package states its own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Read the *source* of sibling packages while building, not their `dist`
    // — otherwise every package would have to be built in dependency order
    // before any of them could emit, and a stale `dist` would silently
    // become another package's types.
    "customConditions": ["development"]
  }
}
