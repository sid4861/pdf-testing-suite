{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Read sibling packages' source, not their built `dist` (W-52).
    "customConditions": ["development"],
    "types": ["node"],
    // DOM for *types only* — ImageData and the canvas types the page loop
    // names. Nothing DOM ships at runtime; the host installs the shim.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // The `?url` shim lives in core, beside the import that needs it.
  "include": ["src", "../core/src/types/vite-shims.d.ts"]
}
