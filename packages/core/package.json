{
  "name": "@pdfsuite/core",
  "version": "2.0.0",
  "description": "Open a PDF, read what is on its pages, and measure it \u2014 the library every pdfsuite surface shares.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "diff": "^5.2.0",
    "pdfjs-dist": "4.10.38",
    "pixelmatch": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
