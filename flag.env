# Feature flags for the PDF Comparison Suite.
#
# Plain KEY=value. Values are read at dev-server start and at build time; while
# `npm run dev` is running, saving this file reloads the browser with the new
# values, so no restart is needed.
#
# Truthy:  true, 1, on, yes, enabled   (case-insensitive)
# Falsy:   anything else, including a missing key.
#
# A flag that is not listed here falls back to the default in
# packages/ui/src/flags.ts, which are all ON — switching something off is a
# thing somebody has to say. Since W-33 this file is **this app's**
# configuration: the shell parses it and passes it to <PdfSuiteApp config>,
# so the package needs no build plugin of its own.

# Click a page in Content / Layout side-by-side to pin a comment.
FEATURE_ANNOTATIONS=true

# "ZIP bundle" entry in the Export menu: every report plus annotated PDFs.
FEATURE_EXPORT_ZIP=true

# Compare's "Many" scope — the key keeps its old name so an existing
# flag.env is not silently reset (W-06).
FEATURE_BATCH_COMPARE=false

# "Side by side" view in the Layout tab. With this off, Layout opens on Diff.
FEATURE_LAYOUT_SIDE_BY_SIDE=false

# "JSON data" and "CSV spreadsheet" entries in every Export menu.
FEATURE_EXPORT_JSON_CSV=false

# "Markdown fix-list": the Export entry and the report viewer tab.
FEATURE_EXPORT_MARKDOWN=false
